---
import '../styles/global.css';
import Header from '../components/Header.astro';
import type { UserPublic } from '../lib/types';

type Props = {
  title?: string;
  user?: UserPublic | null;
  active?: 'ask' | 'browse' | 'search' | null;
  flush?: boolean;
};

const { title = 'Forum', user = null, active = null, flush = false } = Astro.props;
const pageTitle = title === 'Forum' ? 'Forum' : `${title} · Forum`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#ffffff" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <title>{pageTitle}</title>
  </head>
  <body>
    <Header user={user} active={active} />
    {
      flush ? (
        <main class="main main--flush">
          <slot />
        </main>
      ) : (
        <main class="main page-rail">
          <slot />
        </main>
      )
    }
    <script is:inline src="/composer.js" defer></script>
  </body>
</html>
