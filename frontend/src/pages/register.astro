---
import BaseLayout from '../layouts/BaseLayout.astro';
import CsrfInput from '../components/CsrfInput.astro';
import { applySetCookies, ensureCsrf, getCookieHeader, getMe } from '../lib/api';
import { resolveLocale, t } from '../lib/i18n';

const cookie = getCookieHeader(Astro.request);
const locale = resolveLocale(
  cookie,
  Astro.request.headers.get('accept-language'),
  Astro.url.searchParams.get('lang'),
);
const user = await getMe(cookie);
if (user) return Astro.redirect('/');

const error = Astro.url.searchParams.get('error');
const csrf = await ensureCsrf(cookie);
applySetCookies(Astro.response, csrf.setCookies);
---

<BaseLayout title={t(locale, 'joinTitle')} user={null}>
  <div class="auth-card">
    <h1>{t(locale, 'joinTitle')}</h1>
    <p class="lead">{t(locale, 'joinLead')}</p>
    <form method="POST" action="/api/register">
      <CsrfInput token={csrf.token} />
      {error && <div class="alert">{error}</div>}
      <div class="field">
        <label for="username">{t(locale, 'username')}</label>
        <input
          id="username"
          name="username"
          required
          minlength="3"
          maxlength="32"
          pattern="[A-Za-z_][A-Za-z0-9_]{2,31}"
        />
      </div>
      <div class="field">
        <label for="email">{t(locale, 'email')}</label>
        <input id="email" name="email" type="email" required />
      </div>
      <div class="field">
        <label for="display_name">{t(locale, 'displayNameOptional')}</label>
        <input id="display_name" name="display_name" maxlength="64" />
      </div>
      <div class="field">
        <label for="password">{t(locale, 'password')}</label>
        <input id="password" name="password" type="password" required minlength="8" />
      </div>
      <div class="form-actions">
        <button class="btn btn-primary" type="submit">{t(locale, 'join')}</button>
        <span class="muted"><a href="/login">{t(locale, 'signIn')}</a></span>
      </div>
    </form>
  </div>
</BaseLayout>
