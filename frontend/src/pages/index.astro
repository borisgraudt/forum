---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCookieHeader, getMe, listChildren, listRootCategories } from '../lib/api';
import type { Category } from '../lib/types';

const cookie = getCookieHeader(Astro.request);
const user = await getMe(cookie);

type CommunityRow = {
  root: Category;
  children: Category[];
};

let rows: CommunityRow[] = [];
let error: string | null = null;

try {
  const roots = await listRootCategories(cookie);
  rows = await Promise.all(
    roots.map(async (root) => {
      let children: Category[] = [];
      try {
        children = await listChildren(root.slug, cookie);
      } catch {
        children = [];
      }
      return { root, children };
    }),
  );
} catch (e) {
  error = e instanceof Error ? e.message : 'Could not load communities';
}
---

<BaseLayout title="Browse Communities" user={user} active="browse">
  <div class="browse-hero">
    <h1>Browse Communities</h1>
  </div>

  {
    error ? (
      <div class="alert">{error}. Start the API on port 3000.</div>
    ) : rows.length === 0 ? (
      <div class="empty">
        <p>No communities yet.</p>
        {user ? (
          <p style="margin-top:12px">
            <a class="btn btn-primary" href="/categories/new">
              Create a community
            </a>
          </p>
        ) : (
          <p style="margin-top:12px">
            <a href="/login">Sign in</a> to create the first community.
          </p>
        )}
      </div>
    ) : (
      <>
        <div class="toolbar-row">
          {user && (
            <a class="btn btn-secondary btn-sm" href="/categories/new">
              New community
            </a>
          )}
        </div>

        {/* NodeBB-style: parent category block + nested sub rows */}
        <div class="forum-cats">
          {rows.map(({ root, children }) => (
            <section class="forum-cat">
              <header class="forum-cat__header">
                <div class="forum-cat__header-main">
                  <h2 class="forum-cat__title">
                    <a href={`/categories/${root.slug}`}>{root.name}</a>
                  </h2>
                  {root.description && <p class="forum-cat__desc">{root.description}</p>}
                </div>
                {user && (
                  <a class="forum-cat__add" href={`/categories/new?parent=${root.slug}`}>
                    + sub
                  </a>
                )}
              </header>

              {children.length > 0 ? (
                <ul class="forum-cat__children">
                  {children.map((sub) => (
                    <li>
                      <a class="forum-cat__child" href={`/categories/${sub.slug}`}>
                        <span class="forum-cat__child-icon" aria-hidden="true" />
                        <span class="forum-cat__child-body">
                          <span class="forum-cat__child-name">{sub.name}</span>
                          {sub.description && (
                            <span class="forum-cat__child-desc">{sub.description}</span>
                          )}
                        </span>
                        <span class="forum-cat__child-go" aria-hidden="true">
                          →
                        </span>
                      </a>
                    </li>
                  ))}
                </ul>
              ) : (
                <p class="forum-cat__empty">
                  No subcategories.
                  {user && (
                    <>
                      {' '}
                      <a href={`/categories/new?parent=${root.slug}`}>Add one</a>
                    </>
                  )}
                </p>
              )}
            </section>
          ))}
        </div>
      </>
    )
  }
</BaseLayout>
