---
import BaseLayout from '../layouts/BaseLayout.astro';
import CommunityIcon from '../components/CommunityIcon.astro';
import { getCookieHeader, getMe, listRootCategories } from '../lib/api';
import type { Category } from '../lib/types';

const cookie = getCookieHeader(Astro.request);
const user = await getMe(cookie);

let categories: Category[] = [];
let error: string | null = null;
try {
  categories = await listRootCategories(cookie);
} catch (e) {
  error = e instanceof Error ? e.message : 'Could not load communities';
}
---

<BaseLayout title="Browse Communities" user={user} active="browse" wide>
  <div class="browse-hero">
    <h1>Browse Communities</h1>
  </div>

  {
    error ? (
      <div class="alert">{error}. Start the API on port 3000.</div>
    ) : categories.length === 0 ? (
      <div class="empty">
        <p>No communities yet.</p>
        {user ? (
          <p style="margin-top:12px">
            <a class="btn btn-primary" href="/categories/new">
              Create a community
            </a>
          </p>
        ) : (
          <p style="margin-top:12px">
            <a href="/login">Sign in</a> to create the first community.
          </p>
        )}
      </div>
    ) : (
      <ul class="community-grid">
        {categories.map((cat) => (
          <li>
            <a class="community-card" href={`/categories/${cat.slug}`}>
              <CommunityIcon name={cat.name} />
              <span class="community-card__label">{cat.name}</span>
            </a>
          </li>
        ))}
      </ul>
    )
  }

  {
    user && categories.length > 0 && (
      <p style="margin-top:36px;text-align:center">
        <a class="btn btn-secondary btn-sm" href="/categories/new">
          New community
        </a>
      </p>
    )
  }
</BaseLayout>
