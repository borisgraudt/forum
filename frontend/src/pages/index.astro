---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCookieHeader, getMe, isAdmin, listChildren, listRootCategories } from '../lib/api';
import { resolveLocale, t } from '../lib/i18n';
import type { Category } from '../lib/types';

const cookie = getCookieHeader(Astro.request);
const locale = resolveLocale(
  cookie,
  Astro.request.headers.get('accept-language'),
  Astro.url.searchParams.get('lang'),
);

type CommunityRow = {
  root: Category;
  children: Category[];
};

let user: Awaited<ReturnType<typeof getMe>> = null;
let rows: CommunityRow[] = [];
let error: string | null = null;

try {
  const [me, roots] = await Promise.all([getMe(cookie), listRootCategories(cookie)]);
  user = me;
  rows = await Promise.all(
    roots.map(async (root) => {
      let children: Category[] = [];
      try {
        children = await listChildren(root.slug, cookie);
      } catch {
        children = [];
      }
      return { root, children };
    }),
  );
} catch (e) {
  error = e instanceof Error ? e.message : t(locale, 'couldNotLoad');
  if (!user) user = await getMe(cookie).catch(() => null);
}
---

<BaseLayout title={t(locale, 'browseTitle')} user={user} active="browse">
  <div class="browse-hero">
    <h1>{t(locale, 'browseTitle')}</h1>
  </div>

  {
    error ? (
      <div class="alert">
        {error}. {t(locale, 'startApi')}
      </div>
    ) : rows.length === 0 ? (
      <div class="empty">
        <p>{t(locale, 'noCommunities')}</p>
        {isAdmin(user) ? (
          <p style="margin-top:12px">
            <a class="btn btn-primary" href="/categories/new">
              {t(locale, 'createCommunity')}
            </a>
          </p>
        ) : user ? (
          <p style="margin-top:12px" class="muted">
            {t(locale, 'adminWillSetup')}
          </p>
        ) : (
          <p style="margin-top:12px">
            <a href="/login">{t(locale, 'signIn')}</a> — {t(locale, 'signInToSee')}
          </p>
        )}
      </div>
    ) : (
      <>
        <div class="toolbar-row">
          {isAdmin(user) && (
            <a class="btn btn-secondary btn-sm" href="/categories/new">
              {t(locale, 'newCommunity')}
            </a>
          )}
        </div>

        <ul class="cat-list">
          {rows.map(({ root, children }) => (
            <li>
              <a class="cat-list__parent" href={`/categories/${root.slug}`}>
                {root.name}
              </a>
              {root.description && <p class="cat-list__parent-desc">{root.description}</p>}

              {children.length > 0 ? (
                <ul class="cat-list__chips">
                  {children.map((sub) => (
                    <li>
                      <a class="cat-list__chip" href={`/categories/${sub.slug}`}>
                        {sub.name}
                      </a>
                    </li>
                  ))}
                </ul>
              ) : (
                <p class="cat-list__empty">
                  {t(locale, 'noSubcategories')}
                  {isAdmin(user) && (
                    <>
                      {' '}
                      · <a href={`/categories/new?parent=${root.slug}`}>{t(locale, 'add')}</a>
                    </>
                  )}
                </p>
              )}
            </li>
          ))}
        </ul>
      </>
    )
  }
</BaseLayout>
