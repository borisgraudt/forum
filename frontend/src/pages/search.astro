---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCookieHeader, getMe, searchThreads } from '../lib/api';
import { resolveLocale, t } from '../lib/i18n';
import type { SearchHit } from '../lib/types';

const cookie = getCookieHeader(Astro.request);
const locale = resolveLocale(
  cookie,
  Astro.request.headers.get('accept-language'),
  Astro.url.searchParams.get('lang'),
);
const user = await getMe(cookie);
const q = (Astro.url.searchParams.get('q') || '').trim();
const author = (Astro.url.searchParams.get('author') || '').trim();
const category = (Astro.url.searchParams.get('category') || '').trim();
const since = (Astro.url.searchParams.get('since') || '').trim();
const page = Math.max(1, parseInt(Astro.url.searchParams.get('page') || '1', 10) || 1);
const limit = 20;
const offset = (page - 1) * limit;
const hasFilters = Boolean(author || category || since);

let results: SearchHit[] = [];
let total = 0;
let error: string | null = null;

if (q) {
  try {
    const data = await searchThreads(q, cookie, {
      limit,
      offset,
      author: author || undefined,
      category: category || undefined,
      since: since || undefined,
    });
    results = data.results;
    total = data.total;
  } catch (e) {
    error = e instanceof Error ? e.message : 'Search failed';
  }
}

const totalPages = Math.max(1, Math.ceil(total / limit));

function pageHref(p: number) {
  const qs = new URLSearchParams({ q, page: String(p) });
  if (author) qs.set('author', author);
  if (category) qs.set('category', category);
  if (since) qs.set('since', since);
  return `/search?${qs}`;
}
---

<BaseLayout
  title={q ? `${t(locale, 'search')}: ${q}` : t(locale, 'searchTitle')}
  user={user}
  active="search"
>
  <div class="search-page">
    <h1 class="page-title">{t(locale, 'searchTitle')}</h1>
    <p class="page-sub">{t(locale, 'searchLead')}</p>

    <form class="search-form" method="GET" action="/search">
      <div class="search-form__row">
        <input
          class="ask-input"
          type="search"
          name="q"
          value={q}
          placeholder={t(locale, 'searchPlaceholder')}
          required
          minlength="1"
          maxlength="200"
          autofocus
        />
        <button class="btn btn-primary" type="submit">{t(locale, 'searchBtn')}</button>
      </div>

      <details class="search-filters" open={hasFilters || undefined}>
        <summary class="search-filters__summary">{t(locale, 'filters')}</summary>
        <div class="search-filters__grid">
          <label>
            <span>{t(locale, 'filterAuthor')}</span>
            <input
              type="text"
              name="author"
              value={author}
              maxlength="32"
              autocomplete="off"
              class="search-filters__input"
            />
          </label>
          <label>
            <span>{t(locale, 'filterCategory')}</span>
            <input
              type="text"
              name="category"
              value={category}
              maxlength="80"
              autocomplete="off"
              class="search-filters__input"
              placeholder="slug"
            />
          </label>
          <label>
            <span>{t(locale, 'filterSince')}</span>
            <input type="date" name="since" value={since} class="search-filters__input" />
          </label>
        </div>
      </details>
    </form>

    {error && <div class="alert">{error}</div>}

    {
      q && !error && (
        <>
          <p class="search-meta">
            {total} {t(locale, 'resultsFor')} “{q}”
          </p>
          {results.length === 0 ? (
            <div class="empty">{t(locale, 'noMatches')}</div>
          ) : (
            <ul class="search-list">
              {results.map((hit) => (
                <li class="search-list__item">
                  <a
                    class="search-list__link"
                    href={`/categories/${hit.category_slug}/threads/${hit.thread.slug}`}
                  >
                    <span class="search-list__cat">{hit.category_name}</span>
                    <span class="search-list__title">{hit.thread.title}</span>
                    <span class="search-list__snippet">{hit.snippet}</span>
                  </a>
                </li>
              ))}
            </ul>
          )}

          {totalPages > 1 && (
            <nav class="pager" aria-label="Search pagination">
              {page > 1 ? (
                <a class="btn btn-secondary btn-sm" href={pageHref(page - 1)}>
                  {t(locale, 'previous')}
                </a>
              ) : (
                <span class="btn btn-secondary btn-sm" aria-disabled="true">
                  {t(locale, 'previous')}
                </span>
              )}
              <span class="pager__meta">
                {t(locale, 'page')} {page} {t(locale, 'of')} {totalPages}
              </span>
              {page < totalPages ? (
                <a class="btn btn-secondary btn-sm" href={pageHref(page + 1)}>
                  {t(locale, 'next')}
                </a>
              ) : (
                <span class="btn btn-secondary btn-sm" aria-disabled="true">
                  {t(locale, 'next')}
                </span>
              )}
            </nav>
          )}
        </>
      )
    }
  </div>
</BaseLayout>
