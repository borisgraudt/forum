---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCookieHeader, getMe, searchThreads } from '../lib/api';
import type { SearchHit } from '../lib/types';

const cookie = getCookieHeader(Astro.request);
const user = await getMe(cookie);
const q = (Astro.url.searchParams.get('q') || '').trim();
const page = Math.max(1, parseInt(Astro.url.searchParams.get('page') || '1', 10) || 1);
const limit = 20;
const offset = (page - 1) * limit;

let results: SearchHit[] = [];
let total = 0;
let error: string | null = null;

if (q) {
  try {
    const data = await searchThreads(q, cookie, { limit, offset });
    results = data.results;
    total = data.total;
  } catch (e) {
    error = e instanceof Error ? e.message : 'Search failed';
  }
}

const totalPages = Math.max(1, Math.ceil(total / limit));
---

<BaseLayout title={q ? `Search: ${q}` : 'Search'} user={user} active="search">
  <h1 class="page-title">Search</h1>
  <p class="page-sub">Find threads by title or post content.</p>

  <form class="search-form" method="GET" action="/search">
    <input
      class="ask-input"
      type="search"
      name="q"
      value={q}
      placeholder="Search topics and posts…"
      required
      minlength="1"
      maxlength="200"
      autofocus
    />
    <button class="btn btn-primary" type="submit">Search</button>
  </form>

  {error && <div class="alert">{error}</div>}

  {
    q && !error && (
      <>
        <p class="search-meta">
          {total} {total === 1 ? 'result' : 'results'} for “{q}”
        </p>
        {results.length === 0 ? (
          <div class="empty">No matches. Try different keywords.</div>
        ) : (
          <ul class="search-list">
            {results.map((hit) => (
              <li class="search-list__item">
                <a
                  class="search-list__link"
                  href={`/categories/${hit.category_slug}/threads/${hit.thread.slug}`}
                >
                  <span class="search-list__cat">{hit.category_name}</span>
                  <span class="search-list__title">{hit.thread.title}</span>
                  <span class="search-list__snippet">{hit.snippet}</span>
                </a>
              </li>
            ))}
          </ul>
        )}

        {totalPages > 1 && (
          <nav class="pager" aria-label="Search pagination">
            {page > 1 ? (
              <a
                class="btn btn-secondary btn-sm"
                href={`/search?q=${encodeURIComponent(q)}&page=${page - 1}`}
              >
                Previous
              </a>
            ) : (
              <span class="btn btn-secondary btn-sm" aria-disabled="true">
                Previous
              </span>
            )}
            <span class="pager__meta">
              Page {page} of {totalPages}
            </span>
            {page < totalPages ? (
              <a
                class="btn btn-secondary btn-sm"
                href={`/search?q=${encodeURIComponent(q)}&page=${page + 1}`}
              >
                Next
              </a>
            ) : (
              <span class="btn btn-secondary btn-sm" aria-disabled="true">
                Next
              </span>
            )}
          </nav>
        )}
      </>
    )
  }
</BaseLayout>
