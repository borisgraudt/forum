---
import BaseLayout from '../layouts/BaseLayout.astro';
import CsrfInput from '../components/CsrfInput.astro';
import { applySetCookies, ensureCsrf, getCookieHeader, getMe } from '../lib/api';
import { resolveLocale, t } from '../lib/i18n';

const cookie = getCookieHeader(Astro.request);
const locale = resolveLocale(
  cookie,
  Astro.request.headers.get('accept-language'),
  Astro.url.searchParams.get('lang'),
);
const user = await getMe(cookie);
if (user) return Astro.redirect('/');

const error = Astro.url.searchParams.get('error');
const csrf = await ensureCsrf(cookie);
applySetCookies(Astro.response, csrf.setCookies);
---

<BaseLayout title={t(locale, 'signInTitle')} user={null}>
  <div class="auth-card">
    <h1>{t(locale, 'signInTitle')}</h1>
    <p class="lead">{t(locale, 'signInLead')}</p>
    <form method="POST" action="/api/login">
      <CsrfInput token={csrf.token} />
      {error && <div class="alert">{error}</div>}
      <div class="field">
        <label for="login">{t(locale, 'usernameOrEmail')}</label>
        <input id="login" name="login" required autocomplete="username" />
      </div>
      <div class="field">
        <label for="password">{t(locale, 'password')}</label>
        <input id="password" name="password" type="password" required minlength="8" />
      </div>
      <div class="form-actions">
        <button class="btn btn-primary" type="submit">{t(locale, 'signIn')}</button>
        <span class="muted"><a href="/reset-password">{t(locale, 'forgotPassword')}</a></span>
        <span class="muted"
          >{t(locale, 'noAccount')} <a href="/register">{t(locale, 'join')}</a></span
        >
      </div>
    </form>
  </div>
</BaseLayout>
