---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CsrfInput from '../../components/CsrfInput.astro';
import {
  applySetCookies,
  ensureCsrf,
  getCookieHeader,
  getMe,
  isAdmin,
  listRootCategories,
} from '../../lib/api';
import type { Category } from '../../lib/types';

const cookie = getCookieHeader(Astro.request);
const user = await getMe(cookie);
if (!user) return Astro.redirect('/login');
if (!isAdmin(user)) {
  return new Response(null, { status: 403, statusText: 'Forbidden' });
}

const parent = Astro.url.searchParams.get('parent') || '';
const error = Astro.url.searchParams.get('error');
const csrf = await ensureCsrf(cookie);
applySetCookies(Astro.response, csrf.setCookies);

let roots: Category[] = [];
try {
  roots = await listRootCategories(cookie);
} catch {
  /* empty */
}
---

<BaseLayout title={parent ? 'New subcategory' : 'New community'} user={user} active="browse">
  <h1 class="page-title">{parent ? 'New subcategory' : 'New community'}</h1>
  <p class="page-sub">
    {
      parent
        ? 'Add a topic area under this community. Admin only.'
        : 'Top-level communities appear on Browse. Admin only.'
    }
  </p>

  {error && <div class="alert">{error}</div>}

  <form method="POST" action="/api/categories" style="max-width:480px">
    <CsrfInput token={csrf.token} />
    {
      parent ? (
        <input type="hidden" name="parent_slug" value={parent} />
      ) : (
        <div class="field">
          <label for="parent_slug">Parent (optional, for subcategory)</label>
          <select id="parent_slug" name="parent_slug">
            <option value="">— Top-level community —</option>
            {roots.map((r) => (
              <option value={r.slug}>{r.name}</option>
            ))}
          </select>
        </div>
      )
    }
    <div class="field">
      <label for="name">Name</label>
      <input id="name" name="name" required maxlength="80" placeholder="e.g. iPhone" />
    </div>
    <div class="field">
      <label for="description">Description (optional)</label>
      <input id="description" name="description" maxlength="500" />
    </div>
    <div class="form-actions">
      <button class="btn btn-primary" type="submit">Create</button>
      <a class="btn btn-secondary" href={parent ? `/categories/${parent}` : '/admin#categories'}
        >Cancel</a
      >
    </div>
  </form>
</BaseLayout>
