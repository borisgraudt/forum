---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { ApiRequestError, getCategory, getCookieHeader, getMe } from '../../../lib/api';

const { slug } = Astro.params;
if (!slug) {
  return Astro.redirect('/');
}

const cookie = getCookieHeader(Astro.request);
const user = await getMe(cookie);
if (!user) {
  return Astro.redirect('/login');
}

let category;
try {
  category = await getCategory(slug, cookie);
} catch (e) {
  if (e instanceof ApiRequestError && e.status === 404) {
    return new Response(null, { status: 404, statusText: 'Not Found' });
  }
  throw e;
}

const error = Astro.url.searchParams.get('error');
---

<BaseLayout title="Ask a question" user={user}>
  <nav class="breadcrumb" aria-label="Breadcrumb">
    <a href="/">Community</a>
    <span class="sep">/</span>
    <a href={`/categories/${category.slug}`}>{category.name}</a>
    <span class="sep">/</span>
    <span>New</span>
  </nav>

  <div class="panel" style="max-width: 640px">
    <div class="panel__head">
      <h2>Ask a question</h2>
    </div>
    <form class="form" method="POST" action={`/api/categories/${category.slug}/threads`}>
      {error && <div class="alert">{error}</div>}
      <div class="field">
        <label for="title">Title</label>
        <input id="title" name="title" type="text" required maxlength="200" />
      </div>
      <div class="field">
        <label for="body">Details</label>
        <textarea id="body" name="body" required maxlength="50000"></textarea>
      </div>
      <div class="form-actions">
        <button class="btn btn-primary" type="submit">Post</button>
        <a class="btn btn-secondary" href={`/categories/${category.slug}`}>Cancel</a>
      </div>
    </form>
  </div>
</BaseLayout>
