---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import {
  ApiRequestError,
  authorLabel,
  formatWhen,
  getCategory,
  getCookieHeader,
  getMe,
  listThreads,
} from '../../../lib/api';
import type { Category, Thread } from '../../../lib/types';

const { slug } = Astro.params;
if (!slug) return Astro.redirect('/');

const cookie = getCookieHeader(Astro.request);
const user = await getMe(cookie);

let category: Category | undefined;
let children: Category[] = [];
let threads: Thread[] = [];
let error: string | null = null;

try {
  const data = await getCategory(slug, cookie);
  category = data.category;
  children = data.children ?? [];
  // Leaf (subcategory) or root without children → show threads here.
  if (category.parent_id !== null || children.length === 0) {
    threads = await listThreads(slug, cookie);
  }
} catch (e) {
  if (e instanceof ApiRequestError && e.status === 404) {
    return new Response(null, { status: 404, statusText: 'Not Found' });
  }
  error = e instanceof Error ? e.message : 'Could not load';
}

const isRoot = category?.parent_id === null;
const showSubs = isRoot && children.length > 0;
---

<BaseLayout title={category?.name ?? 'Community'} user={user} active="browse">
  {
    error || !category ? (
      <div class="alert">{error || 'Not found'}</div>
    ) : (
      <>
        <nav class="breadcrumb">
          <a href="/">Browse</a>
          <span>/</span>
          <span>{category.name}</span>
        </nav>

        <h1 class="page-title">{category.name}</h1>
        {category.description && <p class="page-sub">{category.description}</p>}

        {showSubs ? (
          <>
            <div class="toolbar-row">
              {user && (
                <a
                  class="btn btn-secondary btn-sm"
                  href={`/categories/new?parent=${category.slug}`}
                >
                  New subcategory
                </a>
              )}
            </div>
            <ul class="sub-list">
              {children.map((sub) => (
                <li>
                  <a href={`/categories/${sub.slug}`}>
                    <span class="sub-list__name">{sub.name}</span>
                    <span class="sub-list__meta">{sub.description || 'View topics'}</span>
                  </a>
                </li>
              ))}
            </ul>
            {children.length === 0 && <div class="empty">No subcategories yet.</div>}
          </>
        ) : (
          <>
            <div class="toolbar-row">
              {user ? (
                <a class="btn btn-primary btn-sm" href={`/ask?category=${category.slug}`}>
                  Ask a question
                </a>
              ) : (
                <a class="btn btn-primary btn-sm" href="/login">
                  Sign in to post
                </a>
              )}
            </div>
            {threads.length === 0 ? (
              <div class="empty">
                No topics yet.
                {user && (
                  <>
                    {' '}
                    <a href={`/ask?category=${category.slug}`}>Start one</a>.
                  </>
                )}
              </div>
            ) : (
              <ul class="thread-list">
                {threads.map((t) => (
                  <li>
                    <a href={`/categories/${category.slug}/threads/${t.slug}`}>
                      <div class="thread-list__title">
                        {t.is_pinned && <span class="badge">Pinned</span>}
                        {t.title}
                      </div>
                      <div class="thread-list__meta">
                        {authorLabel(t)} · {t.post_count} {t.post_count === 1 ? 'post' : 'posts'} ·{' '}
                        {formatWhen(t.last_post_at || t.created_at)}
                      </div>
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </>
        )}
      </>
    )
  }
</BaseLayout>
