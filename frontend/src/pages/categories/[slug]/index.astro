---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Avatar from '../../../components/Avatar.astro';
import CsrfInput from '../../../components/CsrfInput.astro';
import {
  ApiRequestError,
  applySetCookies,
  authorLabel,
  ensureCsrf,
  formatRelative,
  getCategory,
  getCookieHeader,
  getMe,
  isAdmin,
  listThreads,
} from '../../../lib/api';
import type { Category, Thread } from '../../../lib/types';

const { slug } = Astro.params;
if (!slug) return Astro.redirect('/');

const cookie = getCookieHeader(Astro.request);
const page = Math.max(1, parseInt(Astro.url.searchParams.get('page') || '1', 10) || 1);
const sortRaw = Astro.url.searchParams.get('sort') || 'activity';
const sort = ['activity', 'newest', 'unanswered', 'solved'].includes(sortRaw)
  ? sortRaw
  : 'activity';
const limit = 20;
const offset = (page - 1) * limit;

let user: Awaited<ReturnType<typeof getMe>> = null;
let category: Category | undefined;
let parent: Category | null = null;
let children: Category[] = [];
let threads: Thread[] = [];
let total = 0;
let error: string | null = null;
let csrfToken = '';
let viewerWatching = false;

try {
  const csrfP = ensureCsrf(cookie);
  const [me, data, csrf] = await Promise.all([getMe(cookie), getCategory(slug, cookie), csrfP]);
  user = me;
  category = data.category;
  parent = data.parent ?? null;
  children = data.children ?? [];
  viewerWatching = Boolean(data.viewer_watching);
  csrfToken = csrf.token;
  applySetCookies(Astro.response, csrf.setCookies);
  if (category.parent_id !== null || children.length === 0) {
    const list = await listThreads(slug, cookie, { limit, offset, sort });
    threads = list.threads;
    total = list.total;
  }
} catch (e) {
  if (e instanceof ApiRequestError && e.status === 404) {
    return new Response(null, { status: 404, statusText: 'Not Found' });
  }
  error = e instanceof Error ? e.message : 'Could not load';
  if (!user) user = await getMe(cookie).catch(() => null);
}

const isRoot = category?.parent_id === null;
const showSubs = isRoot && children.length > 0;
const totalPages = Math.max(1, Math.ceil(total / limit));
---

<BaseLayout
  title={category?.name ?? 'Forum'}
  description={category?.description || (category ? `${category.name} topics` : 'Forum')}
  user={user}
  active="browse"
  live
>
  {
    error || !category ? (
      <div class="alert">{error || 'Not found'}</div>
    ) : (
      <>
        <nav class="breadcrumb" aria-label="Breadcrumb">
          <a href="/">Browse</a>
          {parent && (
            <>
              <span class="breadcrumb__sep">/</span>
              <a href={`/categories/${parent.slug}`}>{parent.name}</a>
            </>
          )}
          <span class="breadcrumb__sep">/</span>
          <span aria-current="page">{category.name}</span>
        </nav>

        <div class="page-title-row">
          <h1 class="page-title">{category.name}</h1>
          {user && (
            <form
              method="POST"
              action={`/api/categories/${category.slug}/watch`}
              class="inline-form"
              data-live-watch
            >
              <CsrfInput token={csrfToken} />
              <input type="hidden" name="category_id" value={String(category.id)} />
              <input type="hidden" name="action" value={viewerWatching ? 'unwatch' : 'watch'} />
              <button type="submit" class:list={['ad-pill', { 'ad-pill--active': viewerWatching }]}>
                {viewerWatching ? 'Watching' : 'Watch'}
              </button>
            </form>
          )}
        </div>
        {category.description && <p class="page-sub">{category.description}</p>}

        {showSubs ? (
          <>
            <div class="toolbar-row">
              {isAdmin(user) && (
                <a
                  class="btn btn-secondary btn-sm"
                  href={`/categories/new?parent=${category.slug}`}
                >
                  New subcategory
                </a>
              )}
            </div>
            <ul class="stat-list">
              {children.map((sub) => {
                const topics = sub.topic_count ?? 0;
                return (
                  <li>
                    <a class="stat-list__row" href={`/categories/${sub.slug}`}>
                      <span class="stat-list__main">
                        <span class="stat-list__title">{sub.name}</span>
                        {sub.description && <span class="stat-list__desc">{sub.description}</span>}
                      </span>
                      <span class="stat-list__stats">
                        <span class="stat-list__stat" title="Topics">
                          <span class="stat-list__num">{topics}</span>
                          <span class="stat-list__label">{topics === 1 ? 'topic' : 'topics'}</span>
                        </span>
                      </span>
                    </a>
                  </li>
                );
              })}
            </ul>
            {children.length === 0 && <div class="empty">No subcategories yet.</div>}
          </>
        ) : (
          <>
            <div class="topic-toolbar">
              <span class="topic-toolbar__label">Thread</span>
              <div class="topic-toolbar__right">
                <nav class="topic-sort" aria-label="Sort topics">
                  {(
                    [
                      ['activity', 'Active'],
                      ['newest', 'New'],
                      ['unanswered', 'Unanswered'],
                      ['solved', 'Solved'],
                    ] as const
                  ).map(([key, label]) => (
                    <a
                      href={`/categories/${category.slug}?sort=${key}`}
                      class:list={['topic-sort__link', { 'is-active': sort === key }]}
                    >
                      {label}
                    </a>
                  ))}
                </nav>
                <span class="topic-toolbar__hint">
                  {total} {total === 1 ? 'topic' : 'topics'}
                </span>
                {user ? (
                  <a class="btn btn-primary btn-sm" href={`/ask?category=${category.slug}`}>
                    Ask a question
                  </a>
                ) : (
                  <a class="btn btn-primary btn-sm" href="/login">
                    Sign in to post
                  </a>
                )}
              </div>
            </div>

            {threads.length === 0 ? (
              <div class="empty">
                No topics yet.
                {user && (
                  <>
                    {' '}
                    <a href={`/ask?category=${category.slug}`}>Start one</a>.
                  </>
                )}
              </div>
            ) : (
              <>
                <ul class="topic-list topic-list--plain">
                  {threads.map((t) => {
                    const who = authorLabel(t);
                    const replies = Math.max(0, t.post_count - 1);
                    const views = t.view_count ?? 0;
                    const activity = formatRelative(t.last_post_at || t.created_at);
                    return (
                      <li class="topic-list__item">
                        <a
                          class="topic-list__link"
                          href={`/categories/${category.slug}/threads/${t.slug}`}
                        >
                          <Avatar
                            class="topic-list__avatar"
                            name={who}
                            src={t.author_avatar_url}
                            size={40}
                          />
                          <span class="topic-list__main">
                            <span class="topic-list__title">
                              {t.is_pinned && <span class="badge">Pinned</span>}
                              {t.is_locked && <span class="badge badge--muted">Locked</span>}
                              {t.is_solved && <span class="badge badge--ok">Solved</span>}
                              {t.is_unread && <span class="badge">New</span>}
                              {t.title}
                            </span>
                            <span class="topic-list__meta">
                              <span>Latest activity {activity}</span>
                              <span class="topic-list__sep">·</span>
                              <span>
                                {replies} {replies === 1 ? 'reply' : 'replies'}
                              </span>
                              {(t.me_too_count ?? 0) > 0 && (
                                <>
                                  <span class="topic-list__sep">·</span>
                                  <span>{t.me_too_count} me too</span>
                                </>
                              )}
                              <span class="topic-list__sep">·</span>
                              <span>{views} views</span>
                              <span class="topic-list__sep">·</span>
                              <span>
                                asked by <span class="topic-list__user">{who}</span>
                              </span>
                            </span>
                          </span>
                        </a>
                      </li>
                    );
                  })}
                </ul>

                {totalPages > 1 && (
                  <nav class="pager" aria-label="Pagination">
                    {page > 1 ? (
                      <a
                        class="btn btn-secondary btn-sm"
                        href={`/categories/${category.slug}?sort=${sort}&page=${page - 1}`}
                      >
                        Previous
                      </a>
                    ) : (
                      <span class="btn btn-secondary btn-sm" aria-disabled="true">
                        Previous
                      </span>
                    )}
                    <span class="pager__meta">
                      Page {page} of {totalPages}
                    </span>
                    {page < totalPages ? (
                      <a
                        class="btn btn-secondary btn-sm"
                        href={`/categories/${category.slug}?sort=${sort}&page=${page + 1}`}
                      >
                        Next
                      </a>
                    ) : (
                      <span class="btn btn-secondary btn-sm" aria-disabled="true">
                        Next
                      </span>
                    )}
                  </nav>
                )}
              </>
            )}
          </>
        )}
      </>
    )
  }
</BaseLayout>
