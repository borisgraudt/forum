---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import {
  ApiRequestError,
  authorLabel,
  formatWhen,
  getCategory,
  getCookieHeader,
  getMe,
  initials,
  listPosts,
  getThread,
} from '../../../../lib/api';
import type { Category, Post, Thread } from '../../../../lib/types';

const { slug, threadSlug } = Astro.params;
if (!slug || !threadSlug) return Astro.redirect('/');

const cookie = getCookieHeader(Astro.request);
const user = await getMe(cookie);

let category: Category | undefined;
let thread: Thread | undefined;
let posts: Post[] = [];
let error: string | null = null;

try {
  const cat = await getCategory(slug, cookie);
  category = cat.category;
  const t = await getThread(slug, threadSlug, cookie);
  thread = t.thread;
  posts = await listPosts(slug, threadSlug, cookie);
} catch (e) {
  if (e instanceof ApiRequestError && e.status === 404) {
    return new Response(null, { status: 404, statusText: 'Not Found' });
  }
  error = e instanceof Error ? e.message : 'Could not load thread';
}

const formError = Astro.url.searchParams.get('error');
const op = posts[0];
const replies = posts.slice(1);
const topReply = replies[0];
const restReplies = replies.slice(1);
const opAuthor = op ? authorLabel(op) : '';
const replyHref = user ? '#reply' : '/login';
---

<BaseLayout title={thread?.title ?? 'Topic'} user={user} active="browse">
  {
    error || !category || !thread || !op ? (
      <div class="alert">{error || 'Not found'}</div>
    ) : (
      <div class="ad-thread">
        <a class="ad-thread__community" href={`/categories/${category.slug}`}>
          {category.name}
        </a>

        {/* Original question — matches example5.png */}
        <article class="ad-post ad-post--op">
          <header class="ad-post__head">
            <div class="ad-post__avatar" aria-hidden="true">
              {initials(opAuthor)}
            </div>
            <div class="ad-post__who">
              <div class="ad-post__name-row">
                <span class="ad-post__name">{opAuthor}</span>
                <span class="ad-post__role">Author</span>
              </div>
            </div>
          </header>

          <h1 class="ad-post__title">{thread.title}</h1>
          <div class="ad-post__body">{op.body}</div>
          <p class="ad-post__posted">Posted on {formatWhen(op.created_at)}</p>

          <div class="ad-post__footer">
            <div class="ad-post__actions" role="group" aria-label="Question actions">
              <div class="ad-pill-group">
                <button type="button" class="ad-pill" disabled title="Coming soon">
                  <span class="ad-pill__icon" aria-hidden="true">↑</span>
                  Helpful
                </button>
                <button type="button" class="ad-pill" disabled title="Coming soon">
                  <span class="ad-pill__icon" aria-hidden="true">↓</span>
                  Not helpful
                </button>
              </div>
              <button type="button" class="ad-pill" disabled title="Coming soon">
                Me too
              </button>
              {!thread.is_locked && (
                <a class="ad-pill ad-pill--solid" href={replyHref}>
                  Reply
                </a>
              )}
            </div>
          </div>
        </article>

        {/* Top-ranking reply card (first reply), then rest — example5/6 */}
        {topReply && (
          <article class="ad-post ad-post--featured">
            <header class="ad-post__head">
              <div class="ad-post__avatar" aria-hidden="true">
                {initials(authorLabel(topReply))}
              </div>
              <div class="ad-post__who">
                <div class="ad-post__name-row">
                  <span class="ad-post__name">{authorLabel(topReply)}</span>
                </div>
              </div>
              <span class="ad-post__badge">Top-ranking reply</span>
            </header>

            <p class="ad-post__posted ad-post__posted--inline">
              Posted on {formatWhen(topReply.created_at)}
            </p>
            <div class="ad-post__body">{topReply.body}</div>

            <div class="ad-post__footer">
              <div class="ad-post__actions" role="group" aria-label="Reply actions">
                <div class="ad-pill-group">
                  <button type="button" class="ad-pill" disabled title="Coming soon">
                    <span class="ad-pill__icon" aria-hidden="true">↑</span>
                    Helpful
                  </button>
                  <button type="button" class="ad-pill" disabled title="Coming soon">
                    <span class="ad-pill__icon" aria-hidden="true">↓</span>
                    Not helpful
                  </button>
                </div>
                {!thread.is_locked && (
                  <a class="ad-pill" href={replyHref}>
                    Reply
                  </a>
                )}
              </div>
            </div>
          </article>
        )}

        <section class="ad-replies" aria-label="Replies">
          {restReplies.map((post) => {
            const who = authorLabel(post);
            return (
              <article class="ad-post">
                <header class="ad-post__head">
                  <div class="ad-post__avatar" aria-hidden="true">
                    {initials(who)}
                  </div>
                  <div class="ad-post__who">
                    <div class="ad-post__name-row">
                      <span class="ad-post__name">{who}</span>
                      {post.author_id === op.author_id && (
                        <span class="ad-post__role">Author</span>
                      )}
                    </div>
                  </div>
                </header>

                <p class="ad-post__posted ad-post__posted--inline">
                  {formatWhen(post.created_at)}
                  {opAuthor && (
                    <>
                      {' '}
                      in response to {opAuthor}
                    </>
                  )}
                </p>
                <div class="ad-post__body">{post.body}</div>

                <div class="ad-post__footer">
                  <div class="ad-post__actions" role="group" aria-label="Reply actions">
                    <div class="ad-pill-group">
                      <button type="button" class="ad-pill" disabled title="Coming soon">
                        <span class="ad-pill__icon" aria-hidden="true">↑</span>
                        Helpful
                      </button>
                      <button type="button" class="ad-pill" disabled title="Coming soon">
                        <span class="ad-pill__icon" aria-hidden="true">↓</span>
                        Not helpful
                      </button>
                    </div>
                    {!thread.is_locked && (
                      <a class="ad-pill" href={replyHref}>
                        Reply
                      </a>
                    )}
                  </div>
                </div>
              </article>
            );
          })}
        </section>

        {replies.length === 0 && <div class="ad-empty">No replies yet.</div>}

        {thread.is_locked ? (
          <div class="ad-locked">This topic is locked.</div>
        ) : user ? (
          <section class="ad-reply" id="reply">
            <h2 class="ad-reply__heading">Add a reply</h2>
            {formError && <div class="alert">{formError}</div>}
            <form
              method="POST"
              action={`/api/categories/${category.slug}/threads/${thread.slug}/posts`}
            >
              <div class="ad-reply__box">
                <div class="ad-post__avatar ad-reply__avatar" aria-hidden="true">
                  {initials(user.display_name || user.username)}
                </div>
                <div class="ad-reply__editor-wrap">
                  <div class="ask-editor ad-reply__editor">
                    <textarea name="body" required maxlength="50000" placeholder="Write a reply…" />
                    <div class="ask-toolbar" aria-hidden="true">
                      <span>B</span>
                      <span>I</span>
                      <span>U</span>
                    </div>
                  </div>
                  <div class="ad-reply__actions">
                    <button class="btn btn-primary" type="submit">
                      Post reply
                    </button>
                  </div>
                </div>
              </div>
            </form>
          </section>
        ) : (
          <div class="ad-signin">
            <a href="/login">Sign in</a> to reply.
          </div>
        )}
      </div>
    )
  }
</BaseLayout>
