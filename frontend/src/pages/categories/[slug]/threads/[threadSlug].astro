---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import {
  ApiRequestError,
  formatWhen,
  getCategory,
  getCookieHeader,
  getMe,
  getThread,
  listPosts,
} from '../../../../lib/api';
import type { Category, Post, Thread } from '../../../../lib/types';

const { slug, threadSlug } = Astro.params;
if (!slug || !threadSlug) {
  return Astro.redirect('/');
}

const cookie = getCookieHeader(Astro.request);
const user = await getMe(cookie);

let category: Category | undefined;
let thread: Thread | undefined;
let posts: Post[] = [];
let error: string | null = null;

try {
  category = await getCategory(slug, cookie);
  const t = await getThread(slug, threadSlug, cookie);
  thread = t.thread;
  posts = await listPosts(slug, threadSlug, cookie);
} catch (e) {
  if (e instanceof ApiRequestError && e.status === 404) {
    return new Response(null, { status: 404, statusText: 'Not Found' });
  }
  error = e instanceof Error ? e.message : 'Could not load discussion';
}

const formError = Astro.url.searchParams.get('error');
---

<BaseLayout title={thread?.title ?? 'Discussion'} user={user}>
  {
    error || !category || !thread ? (
      <div class="alert">{error || 'Not found'}</div>
    ) : (
      <>
        <nav class="breadcrumb" aria-label="Breadcrumb">
          <a href="/">Community</a>
          <span class="sep">/</span>
          <a href={`/categories/${category.slug}`}>{category.name}</a>
          <span class="sep">/</span>
          <span>{thread.title}</span>
        </nav>

        <section class="page-intro">
          <h1>
            {thread.is_pinned && <span class="badge">Pinned</span>}
            {thread.is_locked && <span class="badge">Locked</span>}
            {thread.title}
          </h1>
          <p>
            {thread.post_count} {thread.post_count === 1 ? 'post' : 'posts'}
            {thread.last_post_at && <> · Last activity {formatWhen(thread.last_post_at)}</>}
          </p>
        </section>

        <div class="panel stack" style="gap:0">
          {posts.map((post, i) => (
            <article class="post">
              <div class="post__meta">
                <span class="post__author">#{i + 1}</span>
                <span>{formatWhen(post.created_at)}</span>
              </div>
              <div class="post__body">{post.body}</div>
            </article>
          ))}
        </div>

        <div style="height: 20px" />

        {thread.is_locked ? (
          <div class="panel">
            <div class="empty">This discussion is locked.</div>
          </div>
        ) : user ? (
          <div class="panel">
            <div class="panel__head">
              <h2>Reply</h2>
            </div>
            <form
              class="form"
              method="POST"
              action={`/api/categories/${category.slug}/threads/${thread.slug}/posts`}
            >
              {formError && <div class="alert">{formError}</div>}
              <div class="field">
                <label for="body">Your reply</label>
                <textarea id="body" name="body" required maxlength="50000" />
              </div>
              <div class="form-actions">
                <button class="btn btn-primary" type="submit">
                  Post reply
                </button>
              </div>
            </form>
          </div>
        ) : (
          <div class="panel">
            <div class="empty">
              <a href="/login">Sign in</a> to reply.
            </div>
          </div>
        )}
      </>
    )
  }
</BaseLayout>
