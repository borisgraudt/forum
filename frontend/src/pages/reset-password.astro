---
import BaseLayout from '../layouts/BaseLayout.astro';
import CsrfInput from '../components/CsrfInput.astro';
import { applySetCookies, ensureCsrf, getCookieHeader, getMe } from '../lib/api';

const cookie = getCookieHeader(Astro.request);
const user = await getMe(cookie);
const csrf = await ensureCsrf(cookie);
applySetCookies(Astro.response, csrf.setCookies);
const token = Astro.url.searchParams.get('token') || '';
const error = Astro.url.searchParams.get('error');
const ok = Astro.url.searchParams.get('ok');
---

<BaseLayout title="Reset password" user={user}>
  <div class="auth-card">
    <h1>Reset password</h1>
    {error && <div class="alert">{error}</div>}
    {ok && <div class="alert alert--ok">Password updated. You can sign in.</div>}
    {
      token ? (
        <form method="POST" action="/api/password-reset/confirm">
          <CsrfInput token={csrf.token} />
          <input type="hidden" name="token" value={token} />
          <div class="field">
            <label for="password">New password</label>
            <input id="password" name="password" type="password" required minlength="8" />
          </div>
          <button class="btn btn-primary" type="submit">
            Save password
          </button>
        </form>
      ) : (
        <form method="POST" action="/api/password-reset">
          <CsrfInput token={csrf.token} />
          <p class="lead">
            Enter your username or email. If it exists, a reset link is logged (dev) / emailed.
          </p>
          <div class="field">
            <label for="login">Username or email</label>
            <input id="login" name="login" required />
          </div>
          <button class="btn btn-primary" type="submit">
            Send reset link
          </button>
        </form>
      )
    }
    <p class="muted" style="margin-top:16px">
      <a href="/login">Back to sign in</a>
    </p>
  </div>
</BaseLayout>
