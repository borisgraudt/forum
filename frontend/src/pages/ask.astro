---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCookieHeader, getMe, listChildren, listRootCategories } from '../lib/api';
import type { Category } from '../lib/types';

const cookie = getCookieHeader(Astro.request);
const user = await getMe(cookie);
if (!user) {
  return Astro.redirect('/login');
}

const preselect = Astro.url.searchParams.get('category') || '';
const error = Astro.url.searchParams.get('error');

let roots: Category[] = [];
let leaves: Category[] = [];
try {
  roots = await listRootCategories(cookie);
  // Collect postable targets: bare roots or their subcategories (parallel).
  const kidsByRoot = await Promise.all(
    roots.map(async (root) => {
      try {
        return await listChildren(root.slug, cookie);
      } catch {
        return [] as Category[];
      }
    }),
  );
  for (let i = 0; i < roots.length; i++) {
    const kids = kidsByRoot[i];
    if (kids.length === 0) {
      leaves.push(roots[i]);
    } else {
      leaves.push(...kids);
    }
  }
} catch {
  /* form still renders */
}
---

<BaseLayout title="Ask a question" user={user} active="ask" flush>
  <section class="ask-hero">
    <h1>Ask a question.</h1>
    <p>
      Questions for the community should include information such as your device, software version,
      and an explanation of the issue.
    </p>
  </section>

  <div class="ask-body">
    {error && <div class="alert">{error}</div>}

    <form method="POST" action="/api/ask">
      <div class="ask-field">
        <label for="category">Community / topic</label>
        <select id="category" name="category" required>
          <option value="" disabled selected={!preselect}> Select a topic </option>
          {
            leaves.map((c) => (
              <option value={c.slug} selected={c.slug === preselect}>
                {c.name}
              </option>
            ))
          }
        </select>
      </div>

      <div class="ask-field">
        <label for="title">Title</label>
        <input
          id="title"
          name="title"
          type="text"
          required
          maxlength="200"
          placeholder="Summarize your question"
        />
      </div>

      <div class="ask-editor">
        <textarea
          name="body"
          required
          maxlength="50000"
          placeholder="Providing steps to reproduce the issue helps community members answer your question. If you share screenshots, please don’t include personal information."
        ></textarea>
        <div class="ask-toolbar" aria-hidden="true">
          <span>B</span>
          <span>I</span>
          <span>U</span>
          <span>|</span>
          <span>•••</span>
        </div>
      </div>
      <p class="ask-hint">✦ Title may be refined later. Review for accuracy.</p>

      <div class="ask-actions">
        <button class="btn btn-primary" type="submit">Continue</button>
        <a class="btn btn-secondary" href="/">Cancel</a>
      </div>
    </form>
  </div>
</BaseLayout>
