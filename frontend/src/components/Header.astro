---
import type { UserPublic } from '../lib/types';

type Props = {
  user?: UserPublic | null;
  active?: 'ask' | 'browse' | 'search' | null;
};

const { user = null, active = null } = Astro.props;
const initial = user ? (user.display_name || user.username).slice(0, 1).toUpperCase() : null;
---

<header class="site-header">
  <div class="site-header__inner">
    <a class="brand" href="/">Community</a>

    <nav class="nav-center" aria-label="Primary">
      <a href="/ask" class:list={[{ 'is-active': active === 'ask' }]}>Ask the Community</a>
      <a href="/" class:list={[{ 'is-active': active === 'browse' }]}>Browse</a>
      <a href="/search" class:list={[{ 'is-active': active === 'search' }]}>Search</a>
    </nav>

    <div class="nav-end">
      {
        user ? (
          <>
            <span class="muted" style="font-size:12px">
              {user.display_name || user.username}
            </span>
            <form method="POST" action="/logout" style="margin:0">
              <button class="btn btn-ghost btn-sm" type="submit">
                Sign out
              </button>
            </form>
            <span class="profile-btn" title={user.username} aria-hidden="true">
              {initial}
            </span>
          </>
        ) : (
          <a class="profile-btn" href="/login" title="Sign in" aria-label="Sign in">
            <svg
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
            >
              <circle cx="12" cy="8" r="3.5" />
              <path d="M5 19c0-3.3 3.1-6 7-6s7 2.7 7 6" />
            </svg>
          </a>
        )
      }
    </div>
  </div>
</header>
