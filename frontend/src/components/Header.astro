---
import Avatar from './Avatar.astro';
import { t, type Locale } from '../lib/i18n';
import type { UserPublic } from '../lib/types';

type Props = {
  user?: UserPublic | null;
  active?: 'ask' | 'browse' | 'search' | null;
  unreadCount?: number;
  locale?: Locale;
};

const { user = null, active = null, unreadCount = 0, locale = 'en' } = Astro.props;
const display = user ? user.display_name || user.username : '';
const isAdmin = user?.role === 'admin';
const isStaff = user?.role === 'moderator' || user?.role === 'admin';
---

<header class="site-header">
  <div class="site-header__inner page-rail">
    <a class="brand" href="/">{t(locale, 'brand')}</a>

    <div class="nav-end">
      <nav class="nav-links" aria-label="Primary">
        <a href="/ask" class:list={[{ 'is-active': active === 'ask' }]}>{t(locale, 'ask')}</a>
        <a href="/" class:list={[{ 'is-active': active === 'browse' }]}>{t(locale, 'browse')}</a>
        <a href="/search" class:list={[{ 'is-active': active === 'search' }]}>
          {t(locale, 'search')}
        </a>
        {
          user && (
            <a href="/notifications" class="nav-notif">
              {t(locale, 'alerts')}
              {unreadCount > 0 && (
                <span class="nav-notif__badge" aria-label={`${unreadCount} ${t(locale, 'unread')}`}>
                  {unreadCount > 9 ? '9+' : unreadCount}
                </span>
              )}
            </a>
          )
        }
      </nav>

      {
        user ? (
          <details class="profile-menu">
            <summary
              class="profile-menu__trigger"
              aria-label={`${t(locale, 'profile')}: ${display}`}
            >
              <span class="profile-btn profile-btn--avatar" aria-hidden="true">
                <Avatar name={display} src={user.avatar_url} size={32} />
              </span>
            </summary>
            <div class="profile-menu__panel" role="menu">
              <div class="profile-menu__who">
                <span class="profile-menu__who-name">{display}</span>
                <span class="profile-menu__who-user">@{user.username}</span>
              </div>
              <a class="profile-menu__link" href={`/u/${user.username}`} role="menuitem">
                {t(locale, 'profile')}
              </a>
              <a class="profile-menu__link" href="/settings/profile" role="menuitem">
                {t(locale, 'settings')}
              </a>
              <a class="profile-menu__link" href="/status" role="menuitem">
                {t(locale, 'status')}
              </a>
              {isStaff && (
                <a class="profile-menu__link" href="/mod" role="menuitem">
                  {t(locale, 'moderation')}
                </a>
              )}
              {isAdmin && (
                <a class="profile-menu__link" href="/admin" role="menuitem">
                  {t(locale, 'admin')}
                </a>
              )}
              <form method="POST" action="/logout" class="profile-menu__form">
                <button type="submit" role="menuitem">
                  {t(locale, 'signOut')}
                </button>
              </form>
            </div>
          </details>
        ) : (
          <a
            class="profile-btn profile-btn--hit"
            href="/login"
            title={t(locale, 'signIn')}
            aria-label={t(locale, 'signIn')}
          >
            <svg
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
              aria-hidden="true"
            >
              <circle cx="12" cy="8" r="3.5" />
              <path d="M5 19c0-3.3 3.1-6 7-6s7 2.7 7 6" />
            </svg>
          </a>
        )
      }
    </div>
  </div>
</header>

<script>
  document.addEventListener('click', (e) => {
    const el = e.target;
    if (!(el instanceof Node)) return;
    document.querySelectorAll('details.profile-menu[open]').forEach((d) => {
      if (!d.contains(el)) d.removeAttribute('open');
    });
  });
</script>
