---
import { initials, mediaUrl } from '../lib/api';

type Props = {
  name: string;
  src?: string | null;
  size?: number;
  class?: string;
  href?: string | null;
};

const { name, src = null, size = 40, class: className = '', href = null } = Astro.props;
const url = mediaUrl(src);
const label = initials(name);
const Tag = href ? 'a' : 'span';
---

<Tag
  class:list={['avatar', className]}
  href={href || undefined}
  style={`width:${size}px;height:${size}px;font-size:${Math.round(size * 0.35)}px`}
  aria-hidden={href ? undefined : 'true'}
  title={href ? name : undefined}
>
  {
    url ? (
      <img src={url} alt="" width={size} height={size} loading="lazy" decoding="async" />
    ) : (
      label
    )
  }
</Tag>

<style>
  .avatar {
    display: inline-grid;
    place-items: center;
    border-radius: 50%;
    background: var(--ink-soft, rgba(45, 41, 40, 0.08));
    color: var(--ink, #2d2928);
    font-weight: 600;
    overflow: hidden;
    flex-shrink: 0;
    text-decoration: none;
    line-height: 1;
  }
  .avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
</style>
