{
  "name": "frontend",
  "type": "module",
  "version": "0.8.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "lint": "npm run format:check && npm run check",
    "check": "astro check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lh": "lighthouse http://127.0.0.1:4322/ --form-factor=mobile --chrome-flags='--headless --no-sandbox' --view",
    "lh:ci": "lighthouse http://127.0.0.1:4322/ --form-factor=mobile --chrome-flags='--headless --no-sandbox' --quiet --only-categories=performance,accessibility,best-practices,seo --output=json --output-path=./lighthouse-report.json"
  },
  "dependencies": {
    "@astrojs/node": "^11.0.3",
    "astro": "^7.1.6"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "prettier": "^3.6.2",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^5.9.2"
  }
}
