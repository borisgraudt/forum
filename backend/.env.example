HOST=0.0.0.0
PORT=3000
DATABASE_URL=sqlite:forum.db?mode=rwc
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_TTL_SECS=604800
# development | production (production rejects weak JWT_SECRET)
FORUM_ENV=development
COOKIE_SECURE=false
# Defaults to true when COOKIE_SECURE=true
ENABLE_HSTS=false
RUST_LOG=info,forum_backend=debug
CORS_ORIGIN=http://localhost:4321
DATA_DIR=./data
PUBLIC_ORIGIN=http://localhost:4321
